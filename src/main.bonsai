                                  <p3:AccumulatedStepsSamplingRate>Rate100Hz</p3:AccumulatedStepsSamplingRate>
                                </harp:Payload>
                              </Expression>
                              <Expression xsi:type="p3:CreateMessage">
                                <harp:MessageType>Write</harp:MessageType>
                                <harp:Payload xsi:type="p3:CreateEnableDigitalInputsPayload">
                                  <p3:EnableDigitalInputs>Input0 Input1 Input2</p3:EnableDigitalInputs>
                                </harp:Payload>
                              </Expression>
                              <Expression xsi:type="p3:CreateMessage">
                                <harp:MessageType>Write</harp:MessageType>
                                <harp:Payload xsi:type="p3:CreateInput0OpModePayload">
                                  <p3:Input0OpMode>StopMotor0OnFalling</p3:Input0OpMode>
                                </harp:Payload>
                              </Expression>
                              <Expression xsi:type="p3:CreateMessage">
                                <harp:MessageType>Write</harp:MessageType>
                                <harp:Payload xsi:type="p3:CreateInput1OpModePayload">
                                  <p3:Input1OpMode>StopMotor1OnFalling</p3:Input1OpMode>
                                </harp:Payload>
                              </Expression>
                              <Expression xsi:type="p3:CreateMessage">
                                <harp:MessageType>Write</harp:MessageType>
                                <harp:Payload xsi:type="p3:CreateInput2OpModePayload">
                                  <p3:Input2OpMode>StopMotor2OnFalling</p3:Input2OpMode>
                                </harp:Payload>
                              </Expression>
                              <Expression xsi:type="Disable">
                                <Builder xsi:type="PropertyMapping">
                                  <PropertyMappings>
