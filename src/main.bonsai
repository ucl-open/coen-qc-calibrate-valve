            <Edge From="8" To="9" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Snapshots</Name>
        <Description>Each Snapshot command saves the calibration camera's latest frame (Camera-Balance.Data), full size, as calibration\runs\&lt;the command's text&gt;.jpg (app-rig-control gives &lt;kind&gt;\&lt;run&gt;\&lt;still&gt;: the run's folder), the folder made if need be. app-rig-control's Calibrations page asks for one once each weight is due and reads the balance's display from it, so no one types the weight. A Snapshot before the camera's first frame saves nothing. Before LiveView, which must stay the last node: it streams only subjects built before it.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>ControlEvents</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>Snapshot</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigFile</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="io:GetDirectoryName" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="Format">
              <Format>{1}\calibration\runs\{0}.jpg</Format>
              <Selector>Item1,Item2</Selector>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Camera-Balance.Data</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>SaveStill</Name>
              <Description>The frame saved to the path: the path mapped onto SaveImage's FileName before the frame reaches it.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item1</Selector>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="FileName" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item2</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="cv:SaveImage">
                      <cv:FileName>snapshot.jpg</cv:FileName>
                      <cv:Suffix>None</cv:Suffix>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="0" To="3" Label="Source1" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="2" To="4" Label="Source2" />
                  <Edge From="4" To="5" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="4" Label="Source1" />
            <Edge From="3" To="4" Label="Source2" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="7" Label="Source1" />
            <Edge From="6" To="7" Label="Source2" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\Spouts.bonsai">
        <RadialInSteps>15000</RadialInSteps>
        <DoneSubjectName>CalibrationWeights</DoneSubjectName>
        <DoneCommand>SpoutsIn</DoneCommand>
      </Expression>
      <Expression xsi:type="lv:StreamDevices">
        <Name>LiveView</Name>
        <Description>Streams the devices in this machine's rig.yml that the workflow publishes, over ZeroMQ, for app-rig-control's Calibrations page: the calibration camera, a temporary device in no rig.yml (Camera-Balance.Data), as Camera-Balance.video on TCP 5558 (5 JPEG frames a second at 320 x 240), data on 5556. Live only: nothing is recorded. Last in the workflow, because it streams only subjects built before it.</Description>
        <lv:ConfigRoot>C:\Coen-Lab-Local\RigConfigs</lv:ConfigRoot>
        <lv:DataPort>5556</lv:DataPort>
        <lv:VideoPort>5558</lv:VideoPort>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
