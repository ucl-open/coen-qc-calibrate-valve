<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System"
                 xmlns:orc="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:cal="clr-namespace:OpenRigs.Core.Calibration;assembly=OpenRigs.Core"
                 xmlns:orcl="clr-namespace:OpenRigs.Control;assembly=OpenRigs.Control"
                 xmlns:lv="clr-namespace:OpenRigs.LiveView;assembly=OpenRigs.LiveView"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Calibrates one reward valve on the behavior board: fires known pulse widths on one line, weighs what each delivers, and writes the weights to calibration\&lt;FileName&gt;-weights.csv beside this machine's rig.yml. It measures only: rig-control builds the curve from the weights once the run completes and writes it to calibration\&lt;FileName&gt;.json, where the rig's experiment workflows read it. rig-control's Calibrations page launches it with the line and the board as its rig.yml gives them (PortName, OutputPulseEnable, Channel, FileName). The balance is read by eye or off the camera: each weight is given with the Weight command when the weigh metric asks for it. The procedure (pulse widths, repeats) is config\valve-calibration.yml. Ready once the board answers; Go runs the procedure; Finished once every burst is weighed.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="ConfigRoot" DisplayName="ConfigRoot" Description="The root under which each machine has its own configuration directory, &lt;ConfigRoot&gt;\&lt;MACHINE-NAME&gt;\rig.yml; the weights are written into calibration\ there." />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Settings</Name>
        <Description>RigConfigDirectory is &lt;ConfigRoot&gt;\&lt;MACHINE-NAME&gt;, where the calibration writes its weights. ValveCalibrationSettings is config\valve-calibration.yml. Fails at startup if the machine has no configuration directory.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="ConfigRoot" DisplayName="ConfigRoot" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orc:ResolveRigConfigDirectory">
                <orc:ConfigRoot>C:\Coen-Lab-Local\RigConfigs</orc:ConfigRoot>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>RigConfigDirectory</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="io:ReadAllText">
                <io:Path>..\config\valve-calibration.yml</io:Path>
              </Combinator>
            </Expression>
            <Expression xsi:type="cal:DeserializeFromYaml">
              <cal:Type xsi:type="TypeMapping" TypeArguments="cal:DispenseCalibration" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>ValveCalibrationSettings</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="SubjectId" />
        <Property Name="SessionId" />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Initialization</Name>
        <Description>The experiment controller (OpenRigs.Control, ExperimentControl) over TCP 5561, which the rig agent relays. Weight takes each weight read off the balance. Reports Recording at Go.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="SubjectId" />
              <Property Name="SessionId" />
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Control:ExperimentControl.bonsai">
              <SubjectId />
              <SessionId />
              <ControlEndpoint>@tcp://127.0.0.1:5561</ControlEndpoint>
              <Parameters />
              <Commands>
                <Command>
                  <Name>Weight</Name>
                  <Description>The balance's reading, in grams, given when the weigh metric asks for it.</Description>
                </Command>
                <Command>
                  <Name>Snapshot</Name>
                  <Description>Saves the body camera's latest frame, full size, as calibration\images\&lt;text&gt;.jpg beside rig.yml: rig-control's Calibrations page reads the balance from it.</Description>
                </Command>
              </Commands>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ExperimentGo</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportPhase">
                <orcl:Phase>Recording</orcl:Phase>
              </Combinator>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="PortName" DisplayName="PortName" Description="The behavior board's serial port: rig.yml's behaviorBoard: main: portName, which rig-control gives at launch." />
        <Property Name="OutputPulseEnable" DisplayName="OutputPulseEnable" Description="The board lines that pulse, such as DO1, DO2: rig.yml's pulseController outputPulseEnable, which rig-control gives at launch." />
        <Property Name="CameraSerialNumber" DisplayName="CameraSerialNumber" Description="The camera shown live while calibrating: rig.yml's camera: body: serialNumber, which rig-control gives at launch." />
        <Property Name="CameraExposureTime" DisplayName="CameraExposureTime" Description="That camera's exposure in microseconds: rig.yml's camera: body: exposureTime, which rig-control gives at launch." />
        <Property Name="CameraFrequency" DisplayName="CameraFrequency" Description="The camera trigger's rate in Hz (trigger 0, the DO0 pin): rig.yml's cameraTriggerController trigger0Frequency, which rig-control gives at launch." />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Hardware</Name>
        <Description>The behavior board on PortName, with the PulseController pulsing the OutputPulseEnable lines: its TriggerCalibratedPulse fires one pulse of a given width on a line, as in a session. The balance is read by eye (OpenRigs.Devices ManualBalance): from Go it asks for each weight in the weigh metric and publishes the one given with the Weight command on BalanceReading. Ready once the board has sent an event. The body camera (CameraSerialNumber, CameraExposureTime) runs on camera trigger 0 (DO0, at CameraFrequency), started 2 s in, publishing Camera-Body.Data for the live view only: nothing is recorded. Trigger 1 stays off, so DO1 stays a valve line.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="PortName" DisplayName="PortName" />
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:BehaviorBoard.BehaviorBoard.bonsai">
              <CommandsSubjectName>BehaviorBoard-Main.Commands</CommandsSubjectName>
              <PortName>COMx</PortName>
              <DumpRegisters>true</DumpRegisters>
              <Heartbeat>Enabled</Heartbeat>
              <EventsSubjectName>BehaviorBoard-Main.Data</EventsSubjectName>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="OutputPulseEnable" DisplayName="OutputPulseEnable" />
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:BehaviorBoard.PulseController.bonsai">
              <BehaviorCommandsSubjectName>BehaviorBoard-Main.Commands</BehaviorCommandsSubjectName>
              <OutputPulseEnable>DO1 DO2</OutputPulseEnable>
              <PulseDO1>10</PulseDO1>
              <PulseDO2>10</PulseDO2>
              <PulseDO3>10</PulseDO3>
              <BehaviorEventsSubjectName>BehaviorBoard-Main.Data</BehaviorEventsSubjectName>
              <TriggerPulseSubjectName>TriggerPulse</TriggerPulseSubjectName>
              <TriggerCalibratedPulseSubjectName>TriggerCalibratedPulse</TriggerCalibratedPulseSubjectName>
            </Expression>
            <Expression xsi:type="rx:PublishSubject" TypeArguments="orc:WeightMeasurement">
              <rx:Name>BalanceReading</rx:Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ValveCalibrationSettings</Name>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>ManualBalance</Name>
              <Description>A balance read by eye, OpenRigs.Devices ManualBalance. From Go it follows the procedure's bursts by the pulses fired and, once each has landed, asks for a weight in the weigh metric; the next weight typed with the Weight command is forwarded to BalanceReading as that burst's reading. Ready once the board has sent an event.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ControlEvents</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="orcl:OnCommand">
                      <orcl:Name>Weight</orcl:Name>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:PublishSubject">
                    <Name>WeightEntries</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ExperimentGo</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ValveCalibrationSettings</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item2</Selector>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ManualBalance.bonsai">
                    <RequestSubjectName>TriggerCalibratedPulse</RequestSubjectName>
                    <EntriesSubjectName>WeightEntries</EntriesSubjectName>
                    <ReadingsSubjectName>ManualReading</ReadingsSubjectName>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="orcl:ReportMetric">
                      <orcl:Name>weigh</orcl:Name>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ManualReading</Name>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>BalanceReading</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>BehaviorBoard-Main.Data</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="orcl:ReportPhase">
                      <orcl:Phase>Ready</orcl:Phase>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="4" To="6" Label="Source1" />
                  <Edge From="5" To="6" Label="Source2" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="10" To="11" Label="Source1" />
                  <Edge From="12" To="13" Label="Source1" />
                  <Edge From="13" To="14" Label="Source1" />
                  <Edge From="11" To="15" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Trigger0Frequency" DisplayName="CameraFrequency" />
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:BehaviorBoard.CameraTriggerController.bonsai">
              <EnableTrigger0>true</EnableTrigger0>
              <EnableTrigger1>false</EnableTrigger1>
              <Trigger0Frequency>50</Trigger0Frequency>
              <Trigger1Frequency>50</Trigger1Frequency>
              <BehaviorCommandsSubjectName>BehaviorBoard-Main.Commands</BehaviorCommandsSubjectName>
              <BehaviorEventsSubjectName>BehaviorBoard-Main.Data</BehaviorEventsSubjectName>
              <Camera0TriggerEventsSubjectName>Camera0TriggerEvents</Camera0TriggerEventsSubjectName>
              <Camera1TriggerEventsSubjectName>Camera1TriggerEvents</Camera1TriggerEventsSubjectName>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="BooleanProperty">
                <Value>true</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Delay">
                <rx:DueTime>PT2S</rx:DueTime>
              </Combinator>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>StartCameras</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="SerialNumber" DisplayName="CameraSerialNumber" />
              <Property Name="ExposureTime" DisplayName="CameraExposureTime" />
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:TriggeredSpinnaker.bonsai">
              <ExposureTime>19000</ExposureTime>
              <Gain>0</Gain>
              <Binning>1</Binning>
              <SerialNumber>00000000</SerialNumber>
              <ColorProcessing>Default</ColorProcessing>
              <CameraTriggerEventsSubjectName>Camera0TriggerEvents</CameraTriggerEventsSubjectName>
              <FrameEventsSubjectName>Camera-Body.Data</FrameEventsSubjectName>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="12" To="13" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Channel" DisplayName="Channel" Description="The behavior board line to calibrate, 1 to 3 (DO1 to DO3): one rig.yml lists in outputPulseEnable. rig-control gives it at launch, from the line chosen on the Calibrations page." />
        <Property Name="FileName" DisplayName="FileName" Description="The calibration's file name without extension, such as valve-DO1: the weights go to calibration\&lt;FileName&gt;-weights.csv, and rig-control writes the curve to calibration\&lt;FileName&gt;.json from them. rig-control gives it at launch." />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Calibration</Name>
        <Description>Reports the line and file as the target metric. At Go, RunCalibration on Channel with ValveCalibrationSettings (the bursts of OpenRigs.Core's DispenseCalibration, without its fit): it primes the line and weighs a baseline, then fires each sample's pulses through TriggerCalibratedPulse and weighs on BalanceReading. Each burst is written as it is weighed to calibration\&lt;FileName&gt;-weights.csv in RigConfigDirectory (columns size, repeats, before, after: its pulse width in ms, its pulses, and the grams before and after it; replaced every run). No fit here: once the run completes, rig-control builds the curve from the weights and writes calibration\&lt;FileName&gt;.json, with history, refusing one that is not monotone. Reports how many bursts were weighed as the points metric, then Finished.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="Channel" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="IntProperty">
                <Value>1</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="FileName" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value>valve-DO1</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Channel" Selector="Item1" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Format">
              <Format>DO{0} into calibration/{1}.json</Format>
              <Selector>Item1,Item2</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportMetric">
                <orcl:Name>target</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigDirectory</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="Format">
              <Format>{0}\calibration\{1}-weights.csv</Format>
              <Selector>Item1,Item2.Item2</Selector>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="FileName" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ExperimentGo</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ValveCalibrationSettings</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item2</Selector>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>RunCalibration</Name>
              <Description>OpenRigs.Core DispenseCalibration's bursts (lib-open-rigs src\OpenRigs.Core\DispenseCalibration.bonsai, copied 7 Nov 2026), without its fit and file writing: primes the line and weighs a baseline, then each sample's burst and its weighing, in turn. The settings sit in a scoped subject so every step reads the same values. Output: each burst once weighed, as ((grams after, grams before), its sample).</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>DispenseSettings</Name>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="Channel" />
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>DispenseSettings</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>DispenseSettings</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="SettleWindow" Selector="Procedure.SettleWindow" />
                      <Property Name="TimeoutSeconds" Selector="Procedure.WeighTimeoutS" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="rx:CreateObservable">
                    <Name>PrimeAndWeighBaseline</Name>
                    <Description>Fires the priming burst to fill the line, then weighs the baseline once it has landed.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Procedure</Selector>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="Channel" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="orc:PulseBurst">
                            <orc:Channel>1</orc:Channel>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>TriggerCalibratedPulse</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>BalanceReading</Name>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="SettleWindow" />
                          <Property Name="TimeoutSeconds" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="orc:WeighStable">
                            <orc:SettleWindow>10</orc:SettleWindow>
                            <orc:TimeoutSeconds>60</orc:TimeoutSeconds>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="3" Label="Source1" />
                        <Edge From="2" To="3" Label="Source2" />
                        <Edge From="3" To="4" Label="Source1" />
                        <Edge From="3" To="7" Label="Source1" />
                        <Edge From="5" To="7" Label="Source2" />
                        <Edge From="6" To="7" Label="Source3" />
                        <Edge From="7" To="8" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>DispenseSettings</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Procedure.Samples</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Concat" />
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>DispenseSettings</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="SettleWindow" Selector="Procedure.SettleWindow" />
                      <Property Name="TimeoutSeconds" Selector="Procedure.WeighTimeoutS" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="rx:CreateObservable">
                    <Name>FireAndWeighSample</Name>
                    <Description>One sample: fires its burst of pulses, then weighs once the last has landed. The samples run in turn, each starting after the previous weighing.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="Channel" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="orc:PulseBurst">
                            <orc:Channel>1</orc:Channel>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>TriggerCalibratedPulse</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>BalanceReading</Name>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="SettleWindow" />
                          <Property Name="TimeoutSeconds" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="orc:WeighStable">
                            <orc:SettleWindow>10</orc:SettleWindow>
                            <orc:TimeoutSeconds>60</orc:TimeoutSeconds>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="2" Label="Source1" />
                        <Edge From="1" To="2" Label="Source2" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="2" To="6" Label="Source1" />
                        <Edge From="4" To="6" Label="Source2" />
                        <Edge From="5" To="6" Label="Source3" />
                        <Edge From="6" To="7" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Concat" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Concat" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Skip">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>DispenseSettings</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Procedure.Samples</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Concat" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="22" Label="Source1" />
                  <Edge From="22" To="1" Label="Source1" />
                  <Edge From="2" To="6" Label="Source2" />
                  <Edge From="2" To="12" Label="Source2" />
                  <Edge From="3" To="6" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source3" />
                  <Edge From="6" To="13" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="9" To="12" Label="Source1" />
                  <Edge From="10" To="11" Label="Source1" />
                  <Edge From="11" To="12" Label="Source3" />
                  <Edge From="12" To="13" Label="Source2" />
                  <Edge From="13" To="14" Label="Source1" />
                  <Edge From="14" To="15" Label="Source1" />
                  <Edge From="14" To="16" Label="Source2" />
                  <Edge From="15" To="16" Label="Source1" />
                  <Edge From="16" To="20" Label="Source1" />
                  <Edge From="17" To="18" Label="Source1" />
                  <Edge From="18" To="19" Label="Source1" />
                  <Edge From="19" To="20" Label="Source2" />
                  <Edge From="20" To="21" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>new(Item2.Size * 1.0 as size, Item2.Repeats as repeats, Item1.Item2 as before, Item1.Item1 as after)</scr:Expression>
            </Expression>
            <Expression xsi:type="io:CsvWriter">
              <io:FileName>valve-weights.csv</io:FileName>
              <io:Append>false</io:Append>
              <io:Overwrite>true</io:Overwrite>
              <io:Suffix>None</io:Suffix>
              <io:IncludeHeader>true</io:IncludeHeader>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Count" />
            </Expression>
            <Expression xsi:type="Format">
              <Format>{0} bursts weighed</Format>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportMetric">
                <orcl:Name>points</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportPhase">
                <orcl:Phase>Finished</orcl:Phase>
              </Combinator>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="4" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source2" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="5" To="7" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="5" To="10" Label="Source2" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="11" To="12" Label="Source1" />
            <Edge From="13" To="15" Label="Source1" />
            <Edge From="14" To="15" Label="Source2" />
            <Edge From="15" To="16" Label="Source1" />
            <Edge From="16" To="17" Label="Source1" />
            <Edge From="6" To="17" Label="Source2" />
            <Edge From="17" To="18" Label="Source1" />
            <Edge From="18" To="19" Label="Source1" />
            <Edge From="12" To="19" Label="Source2" />
            <Edge From="19" To="20" Label="Source1" />
            <Edge From="20" To="21" Label="Source1" />
            <Edge From="21" To="22" Label="Source1" />
            <Edge From="22" To="23" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="lv:StreamDevices">
        <Name>LiveView</Name>
        <Description>Streams the devices in this machine's rig.yml that the workflow publishes, over ZeroMQ, for rig-control's Calibrations page: the body camera as Camera-Body.video on TCP 5558 (5 JPEG frames a second at 320 x 240 unless its liveView: in rig.yml says otherwise), data on 5556. Live only: nothing is recorded. Last in the workflow, because it streams only subjects built before it.</Description>
        <lv:ConfigRoot>C:\Coen-Lab-Local\RigConfigs</lv:ConfigRoot>
        <lv:DataPort>5556</lv:DataPort>
        <lv:VideoPort>5558</lv:VideoPort>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Snapshots</Name>
        <Description>Each Snapshot command saves the body camera's latest frame (Camera-Body.Data), full size, as &lt;RigConfigDirectory&gt;\calibration\images\&lt;the command's text&gt;.jpg, the folder made if need be. rig-control's Calibrations page asks for one once each weight is due and reads the balance's display from it, so no one types the weight. A Snapshot before the camera's first frame saves nothing. After LiveView, which streams nothing of it, so the nodes before it keep their places.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>ControlEvents</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>Snapshot</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigDirectory</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="Format">
              <Format>{1}\calibration\images\{0}.jpg</Format>
              <Selector>Item1,Item2</Selector>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Camera-Body.Data</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>SaveStill</Name>
              <Description>The frame saved to the path: the path mapped onto SaveImage's FileName before the frame reaches it.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item1</Selector>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="FileName" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item2.Value.Image</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="cv:SaveImage">
                      <cv:FileName>snapshot.jpg</cv:FileName>
                      <cv:Suffix>None</cv:Suffix>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="0" To="3" Label="Source1" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="2" To="4" Label="Source2" />
                  <Edge From="4" To="5" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="3" Label="Source1" />
            <Edge From="2" To="3" Label="Source2" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="6" Label="Source1" />
            <Edge From="5" To="6" Label="Source2" />
            <Edge From="6" To="7" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
