                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="vc:UnpackSwitchTriggers" />
                        </Expression>
                        <Expression xsi:type="Index">
                          <Operand xsi:type="IntProperty">
                            <Value>0</Value>
                          </Operand>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>_Motor0_switchState</Name>
                        </Expression>
                        <Expression xsi:type="Index">
                          <Operand xsi:type="IntProperty">
                            <Value>1</Value>
                          </Operand>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>_Motor1_switchState</Name>
                        </Expression>
                        <Expression xsi:type="Index">
                          <Operand xsi:type="IntProperty">
                            <Value>2</Value>
                          </Operand>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>_Motor2_switchState</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>StepperDriver2Events</Name>
                        </Expression>
                        <Expression xsi:type="p3:Parse">
                          <harp:Register xsi:type="p3:DigitalInputState" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="vc:UnpackSwitchTriggers" />
                        </Expression>
                        <Expression xsi:type="Index">
                          <Operand xsi:type="IntProperty">
                            <Value>0</Value>
                          </Operand>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>_Motor3_switchState</Name>
                        </Expression>
                        <Expression xsi:type="Index">
                          <Operand xsi:type="IntProperty">
                            <Value>1</Value>
                          </Operand>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>_Motor4_switchState</Name>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="2" To="5" Label="Source1" />
                        <Edge From="2" To="7" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="7" To="8" Label="Source1" />
                        <Edge From="9" To="10" Label="Source1" />
                        <Edge From="10" To="11" Label="Source1" />
                        <Edge From="11" To="12" Label="Source1" />
                        <Edge From="11" To="14" Label="Source1" />
                        <Edge From="12" To="13" Label="Source1" />
                        <Edge From="14" To="15" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>ZEROMotors</Name>
                    <Description>av-dome's zeroing (its ZEROMotors, Extensions\ZEROingMotors.bonsai): once both boards are set up, each of the five motors moves off its home switch if it is on it, then back until the switch, where its count is set to 0. 2 s after the last, SteppersZEROed. A plain Delay where av-dome waits on the Harp clock (HarpDelay): this workflow has no timestamp generator. The watchdog ends the workflow, naming the stages still missing, if zeroing has not finished 60 s from the start.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                          <SubjectName_switchState>_Motor0_switchState</SubjectName_switchState>
                          <MotorID>0</MotorID>
                          <SubjectName_StepperDriver>StepperDriver1Commands</SubjectName_StepperDriver>
                          <SubjectName_switchState_again>_Motor0_switchState</SubjectName_switchState_again>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                          <SubjectName_switchState>_Motor1_switchState</SubjectName_switchState>
                          <MotorID>1</MotorID>
                          <SubjectName_StepperDriver>StepperDriver1Commands</SubjectName_StepperDriver>
                          <SubjectName_switchState_again>_Motor1_switchState</SubjectName_switchState_again>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                          <SubjectName_switchState>_Motor2_switchState</SubjectName_switchState>
                          <MotorID>2</MotorID>
                          <SubjectName_StepperDriver>StepperDriver1Commands</SubjectName_StepperDriver>
                          <SubjectName_switchState_again>_Motor2_switchState</SubjectName_switchState_again>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                          <SubjectName_switchState>_Motor3_switchState</SubjectName_switchState>
                          <MotorID>0</MotorID>
                          <SubjectName_StepperDriver>StepperDriver2Commands</SubjectName_StepperDriver>
                          <SubjectName_switchState_again>_Motor3_switchState</SubjectName_switchState_again>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                          <SubjectName_switchState>_Motor4_switchState</SubjectName_switchState>
                          <MotorID>1</MotorID>
                          <SubjectName_StepperDriver>StepperDriver2Commands</SubjectName_StepperDriver>
                          <SubjectName_switchState_again>_Motor4_switchState</SubjectName_switchState_again>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Zip" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Delay">
                            <rx:DueTime>PT2S</rx:DueTime>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="BooleanProperty">
                            <Value>true</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>SteppersZEROed</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>Motor0</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>Motor1</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>Motor2</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>Motor3</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>Motor4</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>AllZeroed</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>Settled</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>StepperDriversInitialized</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>StepperDriversInitialized</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="vc:StartupWatchdog">
                            <vc:Expected>StepperDriversInitialized, Motor0, Motor1, Motor2, Motor3, Motor4, AllZeroed, Settled</vc:Expected>
                            <vc:TimeoutSeconds>60</vc:TimeoutSeconds>
                            <vc:What>Zeroing the spout steppers (needed for Ready)</vc:What>
                          </Combinator>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="5" Label="Source1" />
                        <Edge From="1" To="5" Label="Source2" />
                        <Edge From="2" To="5" Label="Source3" />
                        <Edge From="3" To="5" Label="Source4" />
                        <Edge From="4" To="5" Label="Source5" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="7" To="8" Label="Source1" />
                        <Edge From="0" To="9" Label="Source1" />
                        <Edge From="1" To="10" Label="Source1" />
                        <Edge From="2" To="11" Label="Source1" />
                        <Edge From="3" To="12" Label="Source1" />
                        <Edge From="4" To="13" Label="Source1" />
                        <Edge From="5" To="14" Label="Source1" />
                        <Edge From="6" To="15" Label="Source1" />
                        <Edge From="16" To="17" Label="Source1" />
                        <Edge From="17" To="18" Label="Source1" />
                        <Edge From="18" To="19" Label="Source1" />
                        <Edge From="9" To="19" Label="Source2" />
                        <Edge From="10" To="19" Label="Source3" />
                        <Edge From="11" To="19" Label="Source4" />
                        <Edge From="12" To="19" Label="Source5" />
                        <Edge From="13" To="19" Label="Source6" />
                        <Edge From="14" To="19" Label="Source7" />
                        <Edge From="15" To="19" Label="Source8" />
                        <Edge From="19" To="20" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>SteppersZEROed</Name>
                  </Expression>
                  <Expression xsi:type="rx:Condition">
                    <Name>Zeroed?</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Expression>it</scr:Expression>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>StageSettings</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item3</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item2</Selector>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\MoveStepperMotors.bonsai" />
                  <Expression xsi:type="scr:ExpressionTransform">
                    <scr:Expression>TimeSpan.FromSeconds(0.5 + 0.00028 * Math.Max(Math.Max(Math.Max(Math.Abs(it.Item1), Math.Abs(it.Item2)), Math.Max(Math.Abs(it.Item3), Math.Abs(it.Item4))), Math.Abs(it.Item5)))</scr:Expression>
                  </Expression>
                  <Expression xsi:type="rx:SelectMany">
                    <Name>WaitForTheMove</Name>
                    <Description>Waits the time the longest move takes (its steps at the boards' 280 us a step, plus 0.5 s), mapped onto the Delay from a subject, so the Delay has its time before it starts.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="rx:AsyncSubject">
                          <Name>MoveTime</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>MoveTime</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="DueTime" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>MoveTime</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Delay">
                            <rx:DueTime>PT30S</rx:DueTime>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                        <Edge From="3" To="5" Label="Source2" />
                        <Edge From="5" To="6" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="BooleanProperty">
                      <Value>true</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>SpoutsReady</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>CalibrationWeights</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:TakeLast">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>StageSettings</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item3</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:WithLatestFrom" />
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item2</Selector>
                  </Expression>
                  <Expression xsi:type="scr:ExpressionTransform">
                    <scr:Expression>new(it.Item1 as Item1, it.Item2 - 1500 as Item2, it.Item3 - 1500 as Item3, it.Item4 - 1500 as Item4, it.Item5 - 1500 as Item5)</scr:Expression>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\MoveStepperMotors.bonsai" />
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="2" To="5" Label="Source1" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="4" To="5" Label="Source2" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="7" To="10" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="9" To="10" Label="Source2" />
                  <Edge From="10" To="11" Label="Source1" />
                  <Edge From="16" To="17" Label="Source1" />
                  <Edge From="17" To="18" Label="Source1" />
                  <Edge From="19" To="20" Label="Source1" />
                  <Edge From="18" To="21" Label="Source1" />
                  <Edge From="20" To="21" Label="Source2" />
                  <Edge From="21" To="22" Label="Source1" />
                  <Edge From="22" To="23" Label="Source1" />
                  <Edge From="22" To="24" Label="Source1" />
                  <Edge From="24" To="25" Label="Source1" />
                  <Edge From="25" To="26" Label="Source1" />
                  <Edge From="26" To="27" Label="Source1" />
                  <Edge From="27" To="36" Label="Source1" />
                  <Edge From="28" To="29" Label="Source1" />
                  <Edge From="30" To="31" Label="Source1" />
                  <Edge From="29" To="32" Label="Source1" />
                  <Edge From="31" To="32" Label="Source2" />
                  <Edge From="32" To="33" Label="Source1" />
                  <Edge From="33" To="34" Label="Source1" />
                  <Edge From="34" To="35" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Name>NoStage?</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="scr:ExpressionTransform">
                    <scr:Expression>it.Item1 == ""</scr:Expression>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="BooleanProperty">
                <Value>true</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>SpoutsReady</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="12" To="13" Label="Source1" />
            <Edge From="5" To="14" Label="Source1" />
            <Edge From="7" To="14" Label="Source2" />
            <Edge From="9" To="14" Label="Source3" />
            <Edge From="11" To="14" Label="Source4" />
            <Edge From="13" To="14" Label="Source5" />
            <Edge From="1" To="15" Label="Source1" />
            <Edge From="3" To="15" Label="Source2" />
            <Edge From="14" To="15" Label="Source3" />
            <Edge From="15" To="16" Label="Source1" />
            <Edge From="16" To="17" Label="Source1" />
            <Edge From="17" To="18" Label="Source1" />
            <Edge From="16" To="19" Label="Source1" />
            <Edge From="19" To="20" Label="Source1" />
            <Edge From="20" To="21" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="lv:StreamDevices">
        <Name>LiveView</Name>
        <Description>Streams the devices in this machine's rig.yml that the workflow publishes, over ZeroMQ, for rig-control's Calibrations page: the calibration camera, a temporary device in no rig.yml (Camera-Temporary.Data), as Camera-Temporary.video on TCP 5558 (5 JPEG frames a second at 320 x 240), data on 5556. Live only: nothing is recorded. Last in the workflow, because it streams only subjects built before it.</Description>
        <lv:ConfigRoot>C:\Coen-Lab-Local\RigConfigs</lv:ConfigRoot>
        <lv:DataPort>5556</lv:DataPort>
        <lv:VideoPort>5558</lv:VideoPort>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
