                  <Expression xsi:type="GroupWorkflow">
                    <Name>ReadSwitchStates</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>StepperDriver1Events</Name>
                        </Expression>
                        <Expression xsi:type="p3:Parse">
                          <harp:Register xsi:type="p3:DigitalInputState" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="vc:UnpackSwitchTriggers" />
